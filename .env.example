# FMN-AI Operations Agent — Environment Configuration
# Copy to .env and adjust values for your environment.

# ── Core ──────────────────────────────────────────────
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── Storage ───────────────────────────────────────────
DATABASE_URL=sqlite:///./fmn.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=*

# ── Feature flags ─────────────────────────────────────
USE_BLOCKCHAIN=true
USE_VISION=false
USE_VOICE=true
SCHEDULER_ENABLED=true
# 0=observe, 1=simulate, 2=execute
AUTONOMY_LEVEL=1

# ── Blockchain ────────────────────────────────────────
BLOCKCHAIN_MODE=local
FABRIC_CHANNEL=fmn-channel
FABRIC_CHAINCODE=fmn
FABRIC_MSP_ID=FmnMSP
FABRIC_USER=Admin
FABRIC_GATEWAY_ENDPOINT=localhost:7051
ETHEREUM_RPC_URL=
ETHEREUM_CONTRACT_ADDRESS=

# ── LLM / Conversational ──────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
HEDGING_API_URL=

# ── Vector DB / optional stores ───────────────────────
VECTOR_DB_URL=http://localhost:6333
MONGO_URL=
S3_BUCKET=

# ── Business defaults ─────────────────────────────────
FX_ALERT_THRESHOLD_PCT=2.0
DIESEL_PRICE_PER_LITRE=850.0
GRID_TARIFF_PER_KWH=65.0
GAS_TARIFF_PER_KWH=45.0
SOLAR_TARIFF_PER_KWH=8.0
TARGET_EFFICIENCY=0.92
ORCHESTRATOR_INTERVAL_HOURS=6
